@using AthleteCareLite.Core.Models
@using AthleteCareLite.Core.Interfaces
@inject IAthleteRepository AthleteRepo

<EditForm Model="CheckIn" OnValidSubmit="OnSave" class="flex flex-col gap-4">
    <DataAnnotationsValidator />

    <div class="form-control">
        <label class="label"><span class="label-text">Athlete</span></label>
        <InputSelect @bind-Value="CheckIn.AthleteId" class="select select-bordered w-full">
            <option value="">— Select Athlete —</option>
            @foreach (var a in athletes)
            {
                <option value="@a.AthleteId">@a.Name</option>
            }
        </InputSelect>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Date</span></label>
        <input type="date" class="input input-bordered w-full"
               value="@CheckIn.Date.ToString("yyyy-MM-dd")"
               @onchange="e => CheckIn.Date = DateOnly.Parse(e.Value!.ToString()!)" />
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div class="form-control">
            <label class="label"><span class="label-text">Sleep Hours</span></label>
            <InputNumber @bind-Value="CheckIn.SleepHours" class="input input-bordered w-full" min="0" max="24" />
        </div>
        <div class="form-control">
            <label class="label"><span class="label-text">Soreness (1–10)</span></label>
            <InputNumber @bind-Value="CheckIn.SorenessLevel" class="input input-bordered w-full" min="1" max="10" />
        </div>
        <div class="form-control">
            <label class="label"><span class="label-text">Mood (1–10)</span></label>
            <InputNumber @bind-Value="CheckIn.Mood" class="input input-bordered w-full" min="1" max="10" />
        </div>
        <div class="form-control">
            <label class="label"><span class="label-text">Readiness (1–10)</span></label>
            <InputNumber @bind-Value="CheckIn.ReadinessScore" class="input input-bordered w-full" min="1" max="10" />
        </div>
    </div>

    <div class="flex gap-3 justify-end mt-2">
        <a href="@CancelUrl" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public WellnessCheckIn CheckIn { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnSave { get; set; }
    [Parameter] public string CancelUrl { get; set; } = "/wellness";

    private List<Athlete> athletes = [];

    protected override async Task OnInitializedAsync() =>
        athletes = await AthleteRepo.GetAllAsync();
}
