@page "/notes"
@using AthleteCareLite.Core.Interfaces
@using AthleteCareLite.Core.Models
@inject ICoachNoteRepository Repo
@rendermode InteractiveServer

<PageTitle>Coach Notes</PageTitle>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <h1 class="text-2xl font-bold">Coach Notes</h1>
    <a href="/notes/new" class="btn btn-primary">+ New Note</a>
</div>

@if (notes is null)
{
    <div class="flex justify-center p-8"><span class="loading loading-spinner loading-lg"></span></div>
}
else if (!notes.Any())
{
    <div class="alert alert-info">No notes yet.</div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
        @foreach (var n in notes)
        {
            <div class="card bg-base-200 shadow">
                <div class="card-body">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="font-semibold">@(n.Athlete?.Name ?? "—")</p>
                            <p class="text-sm text-base-content/60">@n.Date.ToShortDateString()</p>
                        </div>
                        <div class="flex gap-1">
                            <a href="/notes/@n.NoteId/edit" class="btn btn-xs btn-ghost">Edit</a>
                            <button class="btn btn-xs btn-error btn-ghost" @onclick="() => DeleteAsync(n.NoteId)">Delete</button>
                        </div>
                    </div>
                    <p class="text-sm mt-2 text-base-content/80">@n.NoteText</p>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<CoachNote>? notes;

    protected override async Task OnInitializedAsync() =>
        notes = await Repo.GetAllAsync();

    private async Task DeleteAsync(Guid id)
    {
        await Repo.DeleteAsync(id);
        notes = await Repo.GetAllAsync();
    }

    private Task<List<CoachNote>> LoadAllAsync() =>
        Repo.GetAllAsync();
}
