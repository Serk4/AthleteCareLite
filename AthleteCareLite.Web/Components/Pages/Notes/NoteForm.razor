@using AthleteCareLite.Core.Models
@using AthleteCareLite.Core.Interfaces
@inject IAthleteRepository AthleteRepo

<EditForm Model="Note" OnValidSubmit="OnSave" class="flex flex-col gap-4">
    <DataAnnotationsValidator />

    <div class="form-control">
        <label class="label"><span class="label-text">Athlete</span></label>
        <InputSelect @bind-Value="Note.AthleteId" class="select select-bordered w-full">
            <option value="">— Select Athlete —</option>
            @foreach (var a in athletes)
            {
                <option value="@a.AthleteId">@a.Name</option>
            }
        </InputSelect>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Date</span></label>
        <input type="date" class="input input-bordered w-full"
               value="@Note.Date.ToString("yyyy-MM-dd")"
               @onchange="e => Note.Date = DateOnly.Parse(e.Value!.ToString()!)" />
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Note</span></label>
        <InputTextArea @bind-Value="Note.NoteText" class="textarea textarea-bordered w-full" rows="5" placeholder="Enter note text" />
    </div>

    <div class="flex gap-3 justify-end mt-2">
        <a href="@CancelUrl" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired] public CoachNote Note { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnSave { get; set; }
    [Parameter] public string CancelUrl { get; set; } = "/notes";

    private List<Athlete> athletes = [];

    protected override async Task OnInitializedAsync() =>
        athletes = await AthleteRepo.GetAllAsync();
}
